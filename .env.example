# Copie para .env e ajuste. Nunca versione o arquivo .env.

# PostgreSQL (obrigatório: defina uma senha)
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Portas expostas no host (somente 127.0.0.1)
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Origens autorizadas a chamar a API (CORS), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Swagger UI e /v3/api-docs; use false em ambientes públicos
SPRINGDOC_ENABLED=true

# URL da API usada pelo frontend (embutida no build)
VITE_API_BASE_URL=http://localhost:8080
